{
  "name": "@workspace/venom-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts && node scripts/check-bundle-budget.mjs",
    "check:bundle-budget": "NODE_ENV=production PORT=4173 BASE_PATH=/ vite build --config vite.config.ts && node scripts/check-bundle-budget.mjs",
    "update:bundle-budget": "NODE_ENV=production PORT=4173 BASE_PATH=/ vite build --config vite.config.ts && node scripts/check-bundle-budget.mjs --update",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -b ../../lib/venom-workspace-merge ../../lib/knowledge-text && tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.mjs",
    "test:web": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(command -v chromium || true) playwright test",
    "test:e2e": "pnpm run test:web",
    "test:e2e:auth": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(command -v chromium || true) playwright test --config playwright.auth.config.ts",
    "test:e2e:auth:validation": "VENOM_DESKTOP_AUTH_E2E_PORT=22170 pnpm run test:e2e:auth"
  },
  "devDependencies": {
    "@clerk/react": "^6.14.4",
    "@clerk/themes": "^2.4.57",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "@workspace/knowledge-text": "workspace:*",
    "@workspace/slime": "workspace:*",
    "@workspace/venom-workspace-merge": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "^3.6.0",
    "framer-motion": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  }
}
