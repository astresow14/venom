modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scripts-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "desktop-bundle-budget"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "desktop-auth-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "codegen-freshness"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/venom run test && pnpm --filter @workspace/venom-desktop run test && pnpm --filter @workspace/venom-desktop run test:web"

[[workflows.workflow]]
name = "scripts-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "desktop-bundle-budget"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/venom-desktop run check:bundle-budget"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "desktop-auth-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/venom-desktop run test:e2e:auth:validation"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "codegen-freshness"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-spec run check:freshness"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["chromium", "glib", "nspr", "nss", "at-spi2-atk", "at-spi2-core", "dbus", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "mesa", "xorg.libxcb", "libxkbcommon", "alsa-lib", "libgbm"]

[userenv]

[userenv.shared]
VENOM_GITHUB_MEMBER_IDS = "user_3IAkBsm1TxtePYHeCo7hTsQL92l"
